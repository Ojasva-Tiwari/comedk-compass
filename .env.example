# Database configuration (development)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/comedk_compass

# Dedicated test database (required for running pytest to isolate tests from dev DB)
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/comedk_compass_test

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins; wildcard '*' forbidden in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Internal operational admin token for data health / maintenance endpoints
ADMIN_API_KEY=your-secure-admin-api-key

# Storage paths
RAW_DATA_DIR=data/raw/comedk

# Ingestion & Scraping HTTP settings
HTTP_TIMEOUT=30.0
USER_AGENT=COMEDK-Compass-Ingestion/1.0 (+https://comedk-compass.local)

# Engine Versioning
PARSER_VERSION=1.0.0
